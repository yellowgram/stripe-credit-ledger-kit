# Buyer's Stripe TEST-MODE keys. yellowgram never receives these.
# Dashboard → Developers → API keys. Use sk_test_..., never a live secret, in this demo.
STRIPE_SECRET_KEY=sk_test_replace_me

# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints a whsec_...
# Put that here and restart `npm run dev`. The CLI secret is not the Dashboard webhook secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. "true" or "false" overrides the key prefix (sk_live_ expects live events).
# Unset: sk_live_ expects livemode true; every other key expects livemode false.
# STRIPE_EXPECT_LIVEMODE=false

# Only origin used for Checkout success_url and cancel_url. Request Host is ignored.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recommended database for anything you actually ship: Postgres.
# Matches docker-compose.yml. Uncomment and comment SQLITE_PATH when you use it.
# For Neon/Supabase, append ?sslmode=require to the connection string.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/credits

# Zero-ops alternate. Used when DATABASE_URL is unset or is not a postgres URL.
SQLITE_PATH=./data/ledger.sqlite

# Demo shell only. There is no auth product in this repo.
# Routes attribute every balance read and spend to this id. Do not deploy the shell as-is.
DEMO_USER_ID=demo_user

# Default false. The demo shell is not production.
# true seeds 100 credits and enables spend / race / reset. Leave false in any deployed app.
ALLOW_DEMO_CONTROLS=false

# How long a held reserve stays before the reaper returns the credits. Default 900 (15 minutes).
# CREDIT_HOLD_TTL_SECONDS=900

# Production: run `npm run holds:reap` (default loop is 60 seconds). `--once` does a single pass.
# CREDIT_HOLD_REAP_INTERVAL_SECONDS=60

# Optional. When demo controls are off, checkout/check/track accept this as x-ledger-secret.
# Leave unset in the demo. Your app should call the ledger with a session user id instead.
# LEDGER_API_SECRET=
